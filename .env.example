# Lab 01 — Google GenAI SDK
GEMINI_API_KEY=

# Lab 03 — authenticated MCP server/client (set these in the shell)
MCP_AUTH_TOKEN=dev-token-abc123
MCP_SERVER_URL=http://localhost:8000/mcp

# Lab 04 — WeatherAPI MCP server/client.
# Prefer the dedicated examples under 04-lab/* so both processes can use
# different .env files without sharing conflicting MCP_SERVER_URL values.
WEATHERAPI_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
